<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openworkflow.sdk</groupId>
        <artifactId>openworkflow-examples</artifactId>
        <version>8.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>openworkflow-examples-simpleGet</artifactId>
    <name>Open Workflow :: Examples :: SimpleGet</name>

    <properties>
        <mainClass>org.openworkflow.sdk.impl.BlockingExample</mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openworkflow.sdk</groupId>
            <artifactId>openworkflow-impl-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openworkflow.sdk</groupId>
            <artifactId>openworkflow-impl-http</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>